# YouTube Data API v3 — required for YouTubeHarvester
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Supabase — required for persisting harvested links (Phase 1d+)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides
# HARVESTER_USER_AGENT=CoCBaseAnalyzer/0.1 (+https://github.com/your-org/coc-base-analyzer)
# HARVESTER_REQUEST_DELAY_SEC=1.0
